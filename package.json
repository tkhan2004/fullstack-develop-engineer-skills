{
  "name": "engineering-skills",
  "private": true,
  "version": "0.0.0",
  "description": "Engineering rule system for AI coding agents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "clean": "pnpm -r exec rm -rf dist && rm -rf coverage",
    "smoke": "node apps/cli/dist/cli.js analyze --no-write --deterministic --cwd tests/fixtures/repos/clean-strict"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
